{
  "Logging": {
    "Console": {
      "FormatterName": "json"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "DevOpsPlatformHub.Api",
      "Audience": "DevOpsPlatformHub.Ui",
      "AccessTokenLifetimeMinutes": 60
    }
  }
}
